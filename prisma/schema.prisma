generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  // pg_trgm accelerates the LIKE '%term%' keyword search (manual / qa / community).
  // vector(pgvector) powers the AI diagnosis semantic retrieval (Phase 4 hybrid search).
  extensions = [pg_trgm, vector]
}

model User {
  id           String   @id @default(cuid())
  // Expand phase: retained for compatibility with pre-session-table instances.
  refreshToken String?
  provider     String
  providerId   String
  email        String?
  nickname  String? @unique
  region    String?
  birthDate DateTime?
  gender    String?

  agreedTermsOfService Boolean   @default(false)
  agreedPrivacyPolicy  Boolean   @default(false)
  agreedAge14          Boolean   @default(false)
  agreedMarketing      Boolean   @default(false)
  agreedAt             DateTime?

  profileCompleted Boolean @default(false)
  role             String  @default("user")
  affiliation      String?

  createdAt    DateTime @default(now())

  qnaPosts          QnAPost[]
  qnaAnswers        QnAAnswer[]
  articleScraps     ArticleScrap[]
  qnaScraps         QnAScrap[]
  notifications     Notification[]
  communityPosts    CommunityPost[]
  communityLikes    CommunityLike[]
  communityBookmarks CommunityBookmark[]
  communityPollVotes CommunityPollVote[]
  communityComments CommunityComment[]
  communityCommentLikes CommunityCommentLike[]
  communityPostReports    CommunityPostReport[]
  communityCommentReports CommunityCommentReport[]
  aiChatHistories              AiChatHistory[]
  aiConversations              AiConversation[]
  aiDailyUsages                AiDailyUsage[]
  oauthLoginCodes              OAuthLoginCode[]
  refreshTokenSessions         RefreshTokenSession[]

  @@unique([provider, providerId])
}

model RefreshTokenSession {
  tokenHash String   @id
  jti       String   @unique
  familyId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@index([expiresAt])
}

model OAuthTransaction {
  nonceHash String   @id
  provider  String
  target    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model OAuthLoginCode {
  id        String    @id @default(cuid())
  codeHash  String    @unique
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model ManualCategory {
  id        Int             @id @default(autoincrement())
  name      String          @unique
  slug      String          @unique
  order     Int             @default(0)
  articles  ManualArticle[]
  agencies  Agency[]
  createdAt DateTime        @default(now())
}

model ManualArticle {
  id         Int            @id @default(autoincrement())
  category   ManualCategory @relation(fields: [categoryId], references: [id])
  categoryId Int
  question   String
  summary    String?
  content    String
  order      Int            @default(0)
  scraps     ArticleScrap[]

  // AI 시맨틱 검색용(Phase 4). Prisma가 직접 다루지 못하므로 조회는 $queryRaw,
  // 쓰기는 backfill 스크립트에서 처리한다. embedInputHash는 재임베딩 판정용.
  embedding      Unsupported("vector(1536)")?
  embedInputHash String?

  @@index([question(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([summary(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin)
  // vector HNSW 인덱스는 Prisma 스키마로 표현 불가 → 마이그레이션에서 직접 생성.
}

model Agency {
  id         Int            @id @default(autoincrement())
  category   ManualCategory @relation(fields: [categoryId], references: [id])
  categoryId Int
  region     String
  name       String
  role       String
  contact    String
  createdAt  DateTime       @default(now())

  @@index([categoryId, region])
}

model QnAPost {
  id        Int        @id @default(autoincrement())
  author    User?      @relation(fields: [authorId], references: [id], onDelete: SetNull)
  authorId  String?
  title      String
  content    String
  category   String
  status     String     @default("pending")
  imageUrls  String[]   @default([])
  // AI 챗봇 근거 검색용(pgvector). 변호사 답변이 달린 글만 임베딩한다. 쓰기는 ai.qna.ts / backfill 스크립트.
  embedding      Unsupported("vector(1536)")?
  embedInputHash String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  answer    QnAAnswer?
  scraps    QnAScrap[]

  @@index([authorId])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin)
}

model QnAAnswer {
  id        Int      @id @default(autoincrement())
  post      QnAPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int      @unique
  lawyer    User?    @relation(fields: [lawyerId], references: [id], onDelete: SetNull)
  lawyerId  String?
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([lawyerId])
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin)
}

model QnAScrap {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  post      QnAPost  @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int
  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model Notification {
  id        Int      @id @default(autoincrement())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String
  title     String
  body      String
  read      Boolean  @default(false)
  refId     Int?
  createdAt DateTime @default(now())

  @@index([userId])
}

model CommunityPost {
  id        Int      @id @default(autoincrement())
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: SetNull)
  title     String
  content   String?
  poll      Json?
  imageUrls String[]
  status    String   @default("visible") // visible | hidden | deleted
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  likes    CommunityLike[]
  bookmarks CommunityBookmark[]
  pollVotes CommunityPollVote[]
  comments CommunityComment[]
  reports  CommunityPostReport[]

  @@index([authorId])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin)
}

// Keyword synonym groups for search query expansion. Data-driven so groups can be
// edited without a deploy; loaded and cached in-process by the search layer.
model SearchSynonym {
  id      Int    @id @default(autoincrement())
  groupId Int
  term    String

  @@unique([groupId, term])
  @@index([groupId])
}

model CommunityPostReport {
  id         Int           @id @default(autoincrement())
  postId     Int
  reporterId String
  reason     String?
  post       CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  reporter   User          @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now())

  @@unique([postId, reporterId])
  @@index([postId])
  @@index([reporterId])
}

model CommunityLike {
  userId    String
  postId    Int
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model CommunityBookmark {
  userId    String
  postId    Int
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model CommunityPollVote {
  id          Int           @id @default(autoincrement())
  userId      String
  postId      Int
  optionIndex Int
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  post        CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([userId, postId])
  @@index([postId, optionIndex])
}

model CommunityComment {
  id        Int      @id @default(autoincrement())
  postId    Int
  authorId  String?
  parentId  Int?
  post      CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author    User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent    CommunityComment?  @relation("CommunityCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   CommunityComment[] @relation("CommunityCommentReplies")
  likes     CommunityCommentLike[]
  reports   CommunityCommentReport[]
  content   String
  status    String   @default("visible") // visible | hidden | deleted
  createdAt DateTime      @default(now())

  @@index([postId, parentId])
}

model CommunityCommentReport {
  id         Int              @id @default(autoincrement())
  commentId  Int
  reporterId String
  reason     String?
  comment    CommunityComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  reporter   User             @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())

  @@unique([commentId, reporterId])
  @@index([commentId])
  @@index([reporterId])
}

model CommunityCommentLike {
  userId    String
  commentId Int
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment   CommunityComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime         @default(now())

  @@unique([userId, commentId])
  @@index([commentId])
}

model ArticleScrap {
  id        Int           @id @default(autoincrement())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  article   ManualArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  articleId Int
  createdAt DateTime      @default(now())

  @@unique([userId, articleId])
}

model AiConversation {
  id         String          @id @default(cuid())
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  title      String?         // 첫 상황 요약에서 유도한 대화 제목
  status     String          @default("open") // open | closed
  lastStatus String?         // 마지막 진단 상태(needs_clarification 등) — 다음 턴 힌트
  messages   AiChatHistory[]
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  @@index([userId, updatedAt])
}

model AiChatHistory {
  id               Int             @id @default(autoincrement())
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId           String
  // nullable: 스레드 도입 전 기존 행 보존. 멀티턴 시에만 연결된다.
  conversation     AiConversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId   String?
  question         String
  situationSummary String
  legalAdvice      String
  suggestions      Json
  status           String?         // 이 턴의 진단 상태(관측·문맥 복원용)
  createdAt        DateTime        @default(now())

  @@index([userId])
  @@index([conversationId, createdAt])
}

model AiDailyUsage {
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  date         DateTime @db.Date
  requestCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@id([userId, date])
  @@index([date])
}

